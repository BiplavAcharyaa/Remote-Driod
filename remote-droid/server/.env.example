# Copy to .env and adjust as needed.

# Port the HTTP + WebSocket server listens on
PORT=8080

# How long a generated pairing code stays valid if no browser claims it (ms)
PAIRING_CODE_TTL_MS=300000

# How long an authenticated session token remains valid without activity (ms)
SESSION_IDLE_TIMEOUT_MS=1800000

# Heartbeat interval used to detect dead sockets (ms)
HEARTBEAT_INTERVAL_MS=15000

# Max missed heartbeats before a socket is considered dead and dropped
HEARTBEAT_MAX_MISSES=2

# Set to "true" to log verbose signaling traffic (never logs frame/video data,
# since no video ever passes through this server — WebRTC media is peer-to-peer)
DEBUG_LOGGING=false
